{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {"analytics": false},
  "projects": {
    "reference": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "../word_pdf/angular",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "styles": ["src/styles.css"],
            "assets": [{"glob": "**/*", "input": "public"}],
            "outputHashing": "all",
            "optimization": {"scripts": true, "styles": {"minify": true, "inlineCritical": false}, "fonts": false},
            "budgets": [{"type": "initial", "maximumWarning": "700kB", "maximumError": "1MB"}]
          }
        },
        "serve": {"builder": "@angular/build:dev-server", "options": {"buildTarget": "reference:build"}}
      }
    }
  }
}
