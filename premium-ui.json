{
  "profile": "product-admin",
  "sourceRoots": ["frontend/src"],
  "locale": "fr-FR",
  "canonicalMap": "UX-CONTRACT.md",
  "requiredCapabilities": ["Table Selection", "Form", "Scrollbar"],
  "requiredCommands": ["unit", "typecheck", "build", "browser"],
  "commands": {
    "unit": "python -m unittest discover -s tests -v",
    "typecheck": "npm --prefix frontend run typecheck",
    "build": "npm --prefix frontend run build",
    "browser": "python tests/browser_check.py"
  },
  "evidence": {
    "failurePaths": "tests/test_web.py",
    "browserFlow": "tests/browser_check.py"
  }
}
